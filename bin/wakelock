#!/usr/bin/env bash
# wakelock - Mac の蓋を閉じたまま CLI エージェントを走らせるためのスリープ制御
#
# 二段構えのロックで「作業中だけスリープ無効」を実現する。
#   arm  : 「このセッションは蓋閉じ運用したい」という意思表示 (run / on が作る)
#   hold : 「今まさに作業中」の印 (hooks / plugin が acquire / release で作る)
# SleepDisabled=1 にするのは arm と hold が両方存在するときだけ。
# 承認待ちで hold が外れれば macOS 標準のスリープタイマーに戻る。

set -uo pipefail

STATE_DIR="${WAKELOCK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/wakelock}"
HELPER="${WAKELOCK_HELPER:-/usr/local/libexec/wakelock-helper}"
# テストから差し替えられるよう外部コマンドは変数経由で呼ぶ
PMSET="${WAKELOCK_PMSET:-/usr/bin/pmset}"
# ":-" ではなく "-" を使い、空文字を指定した場合は sudo なしで実行させる (テスト用)
SUDO="${WAKELOCK_SUDO-sudo -n}"
ARM_DIR="$STATE_DIR/arm"
HOLD_DIR="$STATE_DIR/hold"
LOCK_DIR="$STATE_DIR/.lock"
GUARD_PID="$STATE_DIR/guard.pid"
LOG="$STATE_DIR/log"
ENABLED_SINCE="$STATE_DIR/enabled_since"
AUTO_FLAG="$STATE_DIR/auto"
# 最後に自分が整えた SleepDisabled の値。外部による書き換えを見分けるのに使う
APPLIED="$STATE_DIR/applied"
# 外部による書き換えの記録。1 行に「時刻 自分の値 書き換えられた値」
OVERRIDES="$STATE_DIR/overrides"

GUARD_INTERVAL="${WAKELOCK_GUARD_INTERVAL:-20}"
# 有効中に SleepDisabled だけを見張る間隔 (秒、整数)。GUARD_INTERVAL 以上なら見張らない
GUARD_WATCH_INTERVAL="${WAKELOCK_GUARD_WATCH_INTERVAL:-2}"
DEFAULT_ON_DURATION="${WAKELOCK_DEFAULT_DURATION:-2h}"

SELF="$0"
case "$SELF" in
  /*) ;;
  *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")" ;;
esac

# ---------------------------------------------------------------- 基本ユーティリティ

log() {
  mkdir -p "$STATE_DIR"
  printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$$" "$*" >>"$LOG" 2>/dev/null
}

die() {
  printf 'wakelock: %s\n' "$*" >&2
  exit 1
}

now() { date +%s; }

# "90m" "2h" "45s" "30" (数値のみは分) を秒に変換する
parse_duration() {
  local raw="$1" num unit
  case "$raw" in
    *[!0-9smhSMH]*) return 1 ;;
  esac
  num="${raw%[smhSMH]}"
  unit="${raw#$num}"
  [ -z "$num" ] && return 1
  case "$num" in *[!0-9]*) return 1 ;; esac
  case "$unit" in
    s|S) echo $(( num )) ;;
    h|H) echo $(( num * 3600 )) ;;
    m|M|'') echo $(( num * 60 )) ;;
    *) return 1 ;;
  esac
}

# 与えられた文字列を状態ファイル名に使える形へ落とす
sanitize() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-96
}

# PID 0 は「プロセスに紐付かない」印として使うので、生きているとは扱わない。
# kill -0 0 は自分のプロセスグループへの送信として成功してしまうため、明示的に弾く。
alive() {
  local pid="${1:-}"
  [ -n "$pid" ] || return 1
  case "$pid" in *[!0-9]*) return 1 ;; esac
  [ "$pid" -gt 0 ] || return 1
  kill -0 "$pid" 2>/dev/null
}

# ---------------------------------------------------------------- 排他制御

lock() {
  mkdir -p "$STATE_DIR"
  local waited=0 lock_mtime lock_age
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    # 30 秒以上放置されたロックは持ち主が死んだものとみなす。
    # BSD find の -mmin は小数を受け付けないため mtime を直接比較する。
    lock_mtime="$(stat -f %m "$LOCK_DIR" 2>/dev/null || echo 0)"
    lock_age=$(( $(now) - lock_mtime ))
    if [ "$lock_age" -gt 30 ]; then
      log "放置されたロックを解放しました (${lock_age}s)"
      rmdir "$LOCK_DIR" 2>/dev/null
      continue
    fi
    waited=$((waited + 1))
    [ "$waited" -gt 200 ] && die "ロックを取得できませんでした: $LOCK_DIR"
    sleep 0.05
  done
  trap 'unlock' EXIT INT TERM
}

unlock() {
  rmdir "$LOCK_DIR" 2>/dev/null
}

# ---------------------------------------------------------------- pmset 制御

# SleepDisabled は 0 のとき pmset -g に現れないことがあるため、
# 行が無ければ 0 とみなす。
# ただし pmset 自体が何も返さなかった場合は「行が無い」のではなく「読めなかった」ので、
# 0 と混同しないよう unknown を返す。混同すると誤った状態遷移をログに残してしまう。
current_disablesleep() {
  local out
  out="$("$PMSET" -g 2>/dev/null)"
  if [ -z "$out" ]; then
    echo unknown
    return 0
  fi
  printf '%s\n' "$out" \
    | /usr/bin/awk '$1 == "SleepDisabled" { print $2; found = 1 } END { if (!found) print 0 }'
}

# 連続稼働時間を GUI に出すための開始時刻。
# 他者が既に 1 にしていた場合も記録が残るよう、実際に切り替えたかに関わらず整合させる。
record_enabled_since() {
  if [ "$1" = 1 ]; then
    [ -f "$ENABLED_SINCE" ] || now >"$ENABLED_SINCE"
  else
    rm -f "$ENABLED_SINCE"
  fi
}

# 外部 (他のアプリや手作業の pmset) による書き換えを、通常の状態遷移と区別して記録する。
# 他のアプリが定期的に書き換えていると、蓋を閉じたまま寝てしまうため、気付けるようにする。
record_override() {
  local mine="$1" theirs="$2"
  log "外部による上書きを検出: SleepDisabled が $mine から $theirs に書き換えられていたため $mine に戻します"
  printf '%s %s %s\n' "$(now)" "$mine" "$theirs" >>"$OVERRIDES"
  # 記録が際限なく増えないよう、直近の分だけ残す
  if [ "$(wc -l <"$OVERRIDES")" -gt 200 ]; then
    tail -n 100 "$OVERRIDES" >"$OVERRIDES.tmp" && mv "$OVERRIDES.tmp" "$OVERRIDES"
  fi
}

# 指定した時刻以降の、外部による書き換えの回数
override_count_since() {
  [ -f "$OVERRIDES" ] || { echo 0; return; }
  /usr/bin/awk -v since="$1" '$1 >= since { n++ } END { print n + 0 }' "$OVERRIDES"
}

apply_disablesleep() {
  local want="$1" cur overridden=0
  cur="$(current_disablesleep)"
  if [ "$cur" = "$want" ]; then
    record_enabled_since "$want"
    echo "$want" >"$APPLIED"
    return 0
  fi

  # 最後に整えた値のまま変えていないのに違っていれば、外部による上書き
  if [ "$cur" != unknown ] && [ "$(cat "$APPLIED" 2>/dev/null)" = "$want" ]; then
    overridden=1
    record_override "$want" "$cur"
  fi

  # 適用できなかったら、自分が整えた値は分からなくなる。applied を消して、
  # 失敗が続く間の不一致を外部による上書きとして数え続けないようにする
  if [ ! -x "$HELPER" ]; then
    log "helper が見つかりません: $HELPER"
    rm -f "$APPLIED"
    return 1
  fi
  if $SUDO "$HELPER" "$want" >/dev/null 2>&1; then
    if [ "$overridden" = 1 ]; then
      :  # 上書きとして記録済み
    elif [ "$cur" = unknown ]; then
      log "SleepDisabled を $want に設定しました (適用前の値は読み取れず)"
    else
      log "SleepDisabled $cur -> $want"
    fi
    record_enabled_since "$want"
    echo "$want" >"$APPLIED"
    return 0
  fi
  log "helper の実行に失敗しました (want=$want)"
  rm -f "$APPLIED"
  return 1
}

# ---------------------------------------------------------------- 状態の読み書き

# arm ファイル: 1行目 PID / 2行目 期限(epoch, 0 は無期限) / 3行目 ラベル
arm_write() {
  mkdir -p "$ARM_DIR"
  printf '%s\n%s\n%s\n' "$2" "$3" "$4" >"$ARM_DIR/$(sanitize "$1")"
}

# hold ファイル: 1行目 PID / 2行目 ラベル
hold_write() {
  mkdir -p "$HOLD_DIR"
  printf '%s\n%s\n' "$2" "$3" >"$HOLD_DIR/$(sanitize "$1")"
}

arm_remove()  { rm -f "$ARM_DIR/$(sanitize "$1")"; }
hold_remove() { rm -f "$HOLD_DIR/$(sanitize "$1")"; }

count_dir() {
  local d="$1" n=0 f
  [ -d "$d" ] || { echo 0; return; }
  for f in "$d"/*; do
    [ -e "$f" ] || continue
    n=$((n + 1))
  done
  echo "$n"
}

# 死んだプロセスや期限切れの arm / hold を掃除する
prune() {
  local f pid expiry t manual_arm=0
  t="$(now)"

  if [ -d "$ARM_DIR" ]; then
    for f in "$ARM_DIR"/*; do
      [ -e "$f" ] || continue
      pid="$(sed -n '1p' "$f" 2>/dev/null)"
      expiry="$(sed -n '2p' "$f" 2>/dev/null)"
      # PID 0 の arm (手動) はプロセスに紐付かず、期限だけで失効する
      if [ "$pid" != 0 ] && ! alive "$pid"; then
        log "arm 失効 (プロセス終了): $(basename "$f")"
        rm -f "$f"
        continue
      fi
      if [ -n "$expiry" ] && [ "$expiry" != "0" ] && [ "$t" -ge "$expiry" ]; then
        log "arm 失効 (期限切れ): $(basename "$f")"
        rm -f "$f"
        continue
      fi
      [ "$pid" = 0 ] && manual_arm=1
    done
  fi

  if [ -d "$HOLD_DIR" ]; then
    for f in "$HOLD_DIR"/*; do
      [ -e "$f" ] || continue
      pid="$(sed -n '1p' "$f" 2>/dev/null)"
      # PID 0 の hold (手動) は手動の arm に従う。arm が期限切れで消えたら一緒に消す。
      # 残すと、自動モードの arm と組み合わさって、承認待ちでも起き続けてしまう
      if [ "$pid" = 0 ]; then
        if [ "$manual_arm" = 0 ]; then
          log "hold 失効 (手動の有効化が終了): $(basename "$f")"
          rm -f "$f"
        fi
        continue
      fi
      if ! alive "$pid"; then
        log "hold 失効 (プロセス終了): $(basename "$f")"
        rm -f "$f"
      fi
    done
  fi
}

# arm と hold が両方あるときだけスリープを無効化する
reconcile() {
  prune
  local arms holds want
  arms="$(count_dir "$ARM_DIR")"
  holds="$(count_dir "$HOLD_DIR")"
  if [ "$arms" -gt 0 ] && [ "$holds" -gt 0 ]; then
    want=1
  else
    want=0
  fi
  apply_disablesleep "$want"
}

# ---------------------------------------------------------------- 常駐ガード

ensure_guard() {
  local pid
  pid="$(cat "$GUARD_PID" 2>/dev/null)"
  alive "$pid" && return 0
  nohup "$SELF" guard >>"$LOG" 2>&1 &
  echo $! >"$GUARD_PID"
  log "ガード起動 pid=$!"
}

# 有効にしてあるはずなのに、外部から 0 に戻されているか。
# 見張りは頻繁に回るので、arm / hold の数え上げ (外部プロセスを起こさない) と applied で
# 絞り込み、pmset を読むのは有効中だけにする。
# 自分の適用が失敗している間 (applied がない) や、pmset が読めない間は、通常の間隔に任せる。
# 見張りが毎回再計算を起こして、失敗のログを積み上げないようにするため。
overridden_while_active() {
  local applied=""
  [ "$(count_dir "$ARM_DIR")" -gt 0 ] && [ "$(count_dir "$HOLD_DIR")" -gt 0 ] || return 1
  [ -f "$APPLIED" ] && read -r applied <"$APPLIED"
  [ "$applied" = 1 ] || return 1
  [ "$(current_disablesleep)" = 0 ]
}

cmd_guard() {
  log "ガード開始 interval=${GUARD_INTERVAL}s watch=${GUARD_WATCH_INTERVAL}s"
  local arms step="$GUARD_INTERVAL" waited=0
  # 見張りの間隔は整数秒。不正な値や、通常の間隔以上の値なら見張らない
  case "$GUARD_WATCH_INTERVAL" in
    ''|*[!0-9]*) ;;
    *) if [ "$GUARD_WATCH_INTERVAL" -gt 0 ] && [ "$GUARD_WATCH_INTERVAL" -lt "$GUARD_INTERVAL" ]; then
         step="$GUARD_WATCH_INTERVAL"
       fi ;;
  esac
  while :; do
    # 短い間隔で回り、通常の間隔に満たない回は外部からの上書きだけを見る。
    # 有効になったかどうかは毎回数え直すので、hooks が有効にした直後から見張れる
    sleep "$step"
    waited=$((waited + step))
    if [ "$waited" -lt "$GUARD_INTERVAL" ] && ! overridden_while_active; then
      continue
    fi
    waited=0
    lock
    prune
    reconcile
    arms="$(count_dir "$ARM_DIR")"
    unlock
    trap - EXIT INT TERM
    [ "$arms" -eq 0 ] && break
  done
  lock
  apply_disablesleep 0
  rm -f "$GUARD_PID"
  unlock
  log "ガード終了"
}

# ---------------------------------------------------------------- 呼び出し元 PID の解決

# hooks は CLI の子プロセスとして起動されるため、祖先を辿って
# claude / opencode 本体の PID を割り出す。見つからなければ $PPID を使う。
find_owner_pid() {
  local p="${1:-$PPID}" n=0 comm
  while [ -n "$p" ] && [ "$p" -gt 1 ] && [ "$n" -lt 12 ]; do
    comm="$(ps -o comm= -p "$p" 2>/dev/null | sed 's:.*/::')"
    case "$comm" in
      claude|claude.exe|opencode|node|bun) echo "$p"; return 0 ;;
    esac
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    n=$((n + 1))
  done
  echo "${1:-$PPID}"
}

# 指定 PID の祖先チェーンを列挙する
ancestors() {
  local p="${1:-$$}" n=0
  while [ -n "$p" ] && [ "$p" -gt 1 ] && [ "$n" -lt 24 ]; do
    echo "$p"
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    n=$((n + 1))
  done
}

# この PID が属するセッションが arm 済みかを判定する。
# arm されていないセッションからの acquire は無視され、これが opt-in の担保になる。
armed_for() {
  local pid="$1" f apid chain
  [ -d "$ARM_DIR" ] || return 1
  chain="$(ancestors "$pid")"
  for f in "$ARM_DIR"/*; do
    [ -e "$f" ] || continue
    apid="$(sed -n '1p' "$f" 2>/dev/null)"
    [ "$apid" = "0" ] && return 0
    printf '%s\n' "$chain" | grep -qx "$apid" && return 0
  done
  return 1
}

# run が張った arm のうち、ラベルが一致し本体が生きているものがあるかを判定する。
# opencode 2.0 は作業を常駐サービスが持ち、そのサービスは run で包んだ TUI の子孫にならない。
# 祖先の照合では run の arm に届かないので、--match-label が付いた acquire に限りこちらで照合する。
# 対象を run の arm に絞り、自動モードや手動の arm の意味は変えない。
run_armed_for_label() {
  local label="$1" f apid
  [ -d "$ARM_DIR" ] || return 1
  for f in "$ARM_DIR"/run-*; do
    [ -e "$f" ] || continue
    [ "$(sed -n '3p' "$f" 2>/dev/null)" = "$label" ] || continue
    apid="$(sed -n '1p' "$f" 2>/dev/null)"
    alive "$apid" && return 0
  done
  return 1
}

# ---------------------------------------------------------------- サブコマンド

RUN_ARMID=""

run_cleanup() {
  [ -n "$RUN_ARMID" ] || return 0
  local id="$RUN_ARMID"
  RUN_ARMID=""
  lock
  arm_remove "$id"
  hold_remove "$id"
  reconcile
  unlock
  trap - EXIT INT TERM
}

cmd_run() {
  local mode="" duration="" secs expiry=0 base armid rc

  while [ $# -gt 0 ]; do
    case "$1" in
      --hooked) mode=hooked; shift ;;
      --always) mode=always; shift ;;
      --for)    duration="${2:-}"; shift 2 ;;
      --)       shift; break ;;
      -*)       die "不明なオプション: $1" ;;
      *)        break ;;
    esac
  done
  [ $# -gt 0 ] || die "実行するコマンドを指定してください (例: wakelock run claude)"

  base="$(basename "$1")"
  if [ -z "$mode" ]; then
    # hooks / plugin を仕込んである CLI は作業中だけロックを取る。
    # それ以外はプロセスが生きている間ずっとロックする。
    case "$base" in
      claude|claude.exe|opencode) mode=hooked ;;
      *) mode=always ;;
    esac
  fi

  if [ -n "$duration" ]; then
    secs="$(parse_duration "$duration")" || die "期間の書式が不正です: $duration (例: 90m, 2h, 45s)"
    expiry=$(( $(now) + secs ))
  fi

  armid="run-$$"
  RUN_ARMID="$armid"
  lock
  arm_write "$armid" "$$" "$expiry" "$base"
  [ "$mode" = always ] && hold_write "$armid" "$$" "$base"
  ensure_guard
  reconcile
  unlock
  trap 'run_cleanup' EXIT INT TERM

  printf 'wakelock: %s を %s モードで監視します (解除は自動)\n' "$base" "$mode" >&2
  "$@"
  rc=$?
  run_cleanup
  exit "$rc"
}

cmd_on() {
  local mode=always duration="" secs expiry
  while [ $# -gt 0 ]; do
    case "$1" in
      --hooked) mode=hooked; shift ;;
      --always) mode=always; shift ;;
      -*) die "不明なオプション: $1" ;;
      *) duration="$1"; shift ;;
    esac
  done
  [ -n "$duration" ] || duration="$DEFAULT_ON_DURATION"

  case "$duration" in
    0|inf|infinite|forever)
      # 無期限。PID にも紐付かないため、解除は明示的な操作だけになる。
      expiry=0
      ;;
    *)
      secs="$(parse_duration "$duration")" \
        || die "期間の書式が不正です: $duration (例: 90m, 2h, 無期限は 0)"
      expiry=$(( $(now) + secs ))
      ;;
  esac

  lock
  # PID 0 は「プロセスに紐付かない手動 arm」を意味し、期限だけで失効する
  arm_write manual 0 "$expiry" "manual"
  if [ "$mode" = always ]; then
    hold_write manual 0 "manual"
  else
    hold_remove manual
  fi
  ensure_guard
  reconcile
  unlock

  if [ "$expiry" = 0 ]; then
    printf 'wakelock: 無期限で有効化しました (%s モード)\n' "$mode"
    printf '  自動では解除されません。wakelock off かメニューバーから解除してください\n'
  else
    printf 'wakelock: %s まで有効化しました (%s モード)\n' "$(date -r "$expiry" '+%H:%M')" "$mode"
  fi
}

cmd_off() {
  lock
  rm -rf "$ARM_DIR" "$HOLD_DIR"
  apply_disablesleep 0
  unlock
  echo "wakelock: すべて解除しました"
}

# GUI から読むための機械可読な状態出力
status_json() {
  local f pid expiry label sd guard since arms holds t
  t="$(now)"
  sd="$(current_disablesleep)"
  [ "$sd" = unknown ] && sd=0
  guard="$(cat "$GUARD_PID" 2>/dev/null)"
  alive "$guard" || guard=""
  since="$(cat "$ENABLED_SINCE" 2>/dev/null)"

  arms="$(
    if [ -d "$ARM_DIR" ]; then
      for f in "$ARM_DIR"/*; do
        [ -e "$f" ] || continue
        pid="$(sed -n '1p' "$f")"; expiry="$(sed -n '2p' "$f")"; label="$(sed -n '3p' "$f")"
        /usr/bin/jq -n \
          --arg id "$(basename "$f")" --arg pid "${pid:-0}" \
          --arg expiry "${expiry:-0}" --arg label "${label:-}" --arg now "$t" '
          {
            id: $id,
            pid: ($pid | tonumber),
            label: $label,
            expiry: ($expiry | tonumber),
            remaining: (if ($expiry | tonumber) == 0 then null
                        else (($expiry | tonumber) - ($now | tonumber)) end)
          }'
      done
    fi | /usr/bin/jq -s '.'
  )"

  holds="$(
    if [ -d "$HOLD_DIR" ]; then
      for f in "$HOLD_DIR"/*; do
        [ -e "$f" ] || continue
        pid="$(sed -n '1p' "$f")"; label="$(sed -n '2p' "$f")"
        /usr/bin/jq -n --arg id "$(basename "$f")" --arg pid "${pid:-0}" --arg label "${label:-}" '
          { id: $id, pid: ($pid | tonumber), label: $label }'
      done
    fi | /usr/bin/jq -s '.'
  )"

  local auto="false"
  [ -f "$AUTO_FLAG" ] && auto="true"

  local ov_last="" ov_hour
  [ -f "$OVERRIDES" ] && ov_last="$(tail -n 1 "$OVERRIDES" | cut -d' ' -f1)"
  ov_hour="$(override_count_since $((t - 3600)))"

  /usr/bin/jq -n \
    --argjson auto "$auto" \
    --arg sd "${sd:-0}" --arg guard "$guard" --arg since "$since" --arg now "$t" \
    --arg ovlast "$ov_last" --arg ovhour "$ov_hour" \
    --argjson arms "${arms:-[]}" --argjson holds "${holds:-[]}" '
    {
      auto: $auto,
      overrides: {
        last: (if $ovlast == "" then null else ($ovlast | tonumber) end),
        lastHour: ($ovhour | tonumber)
      },
      sleepDisabled: ($sd | tonumber),
      guard: {
        running: ($guard != ""),
        pid: (if $guard == "" then null else ($guard | tonumber) end)
      },
      enabledSince: (if $since == "" then null else ($since | tonumber) end),
      enabledForSeconds: (if $since == "" then null
                          else (($now | tonumber) - ($since | tonumber)) end),
      arms: $arms,
      holds: $holds,
      now: ($now | tonumber)
    }'
}

cmd_status() {
  if [ "${1:-}" = "--json" ]; then
    status_json
    return 0
  fi
  local f pid expiry label sd guard remain
  sd="$(current_disablesleep)"
  [ "$sd" = unknown ] && sd="不明"
  guard="$(cat "$GUARD_PID" 2>/dev/null)"

  printf '自動モード    : %s\n' "$([ -f "$AUTO_FLAG" ] && echo '有効' || echo '無効')"
  printf 'SleepDisabled : %s%s\n' "$sd" "$([ "$sd" = 1 ] && echo '  (蓋を閉じても動作します)' || echo '  (通常のスリープ設定)')"
  if alive "$guard"; then
    printf 'ガード        : 稼働中 (pid %s)\n' "$guard"
  else
    printf 'ガード        : 停止中\n'
  fi
  local ov_hour
  ov_hour="$(override_count_since $(( $(now) - 3600 )))"
  if [ "$ov_hour" -gt 0 ]; then
    printf '外部の上書き  : 直近 1 時間に %s 回 (最終 %s)  wakelock doctor を参照\n' \
      "$ov_hour" "$(date -r "$(tail -n 1 "$OVERRIDES" | cut -d' ' -f1)" '+%H:%M:%S')"
  fi

  printf '\narm (蓋閉じ運用の意思表示):\n'
  if [ "$(count_dir "$ARM_DIR")" -eq 0 ]; then
    printf '  なし\n'
  else
    for f in "$ARM_DIR"/*; do
      [ -e "$f" ] || continue
      pid="$(sed -n '1p' "$f")"; expiry="$(sed -n '2p' "$f")"; label="$(sed -n '3p' "$f")"
      if [ "$expiry" = "0" ] || [ -z "$expiry" ]; then
        remain="無期限"
      else
        remain="残り $(( (expiry - $(now)) / 60 )) 分"
      fi
      printf '  %-24s pid=%-8s %s  [%s]\n' "$(basename "$f")" "$pid" "$remain" "$label"
    done
  fi

  printf '\nhold (現在作業中):\n'
  if [ "$(count_dir "$HOLD_DIR")" -eq 0 ]; then
    printf '  なし\n'
  else
    for f in "$HOLD_DIR"/*; do
      [ -e "$f" ] || continue
      pid="$(sed -n '1p' "$f")"; label="$(sed -n '2p' "$f")"
      printf '  %-24s pid=%-8s [%s]\n' "$(basename "$f")" "$pid" "$label"
    done
  fi
}

cmd_acquire() {
  local id="" pid="" label="hook" match_label=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pid)         pid="${2:-}"; shift 2 ;;
      --label)       label="${2:-hook}"; shift 2 ;;
      --match-label) match_label=1; shift ;;
      *)             [ -z "$id" ] && id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || die "acquire には ID が必要です"
  [ -n "$pid" ] || pid="$(find_owner_pid "$PPID")"

  local file="$HOLD_DIR/$(sanitize "$id")"
  # 既に同じ内容の hold があれば pmset を叩かず即返す (毎ツール呼び出しの負荷を避ける)
  if [ -f "$file" ] && [ "$(sed -n '1p' "$file")" = "$pid" ]; then
    return 0
  fi

  lock
  if ! armed_for "$pid" && ! { [ "$match_label" = 1 ] && run_armed_for_label "$label"; }; then
    if [ -f "$AUTO_FLAG" ]; then
      # 自動モード: このセッションを自動で arm する。
      # arm は CLI 本体の PID に束縛するので、CLI が終われば掃除される。
      arm_write "auto-$pid" "$pid" 0 "$label"
      log "自動モード: pid=$pid ($label) を arm しました"
    else
      # 自動モードでも run でもないセッションは対象外。何もしない。
      unlock
      trap - EXIT INT TERM
      return 0
    fi
  fi
  hold_write "$id" "$pid" "$label"
  ensure_guard
  reconcile
  unlock
}

# 自動モード: hooks / plugin からの acquire だけで完結させる。
# wakelock run を打たなくても claude / opencode の作業中だけ蓋閉じが有効になる。
cmd_auto() {
  case "${1:-status}" in
    on)
      mkdir -p "$STATE_DIR"
      now >"$AUTO_FLAG"
      echo "wakelock: 自動モードを有効にしました"
      echo "  claude / opencode を普通に起動するだけで、作業中は蓋を閉じても動作します"
      ;;
    off)
      rm -f "$AUTO_FLAG"
      lock
      # 自動で張った arm を取り下げる (手動 arm と run の arm は残す)
      local f
      if [ -d "$ARM_DIR" ]; then
        for f in "$ARM_DIR"/auto-*; do
          [ -e "$f" ] || continue
          rm -f "$f"
        done
      fi
      reconcile
      unlock
      echo "wakelock: 自動モードを無効にしました"
      ;;
    status)
      [ -f "$AUTO_FLAG" ] && echo "有効" || echo "無効"
      ;;
    *)
      die "使い方: wakelock auto on|off|status"
      ;;
  esac
}

cmd_release() {
  local id="${1:-}"
  [ -n "$id" ] || die "release には ID が必要です"
  [ -f "$HOLD_DIR/$(sanitize "$id")" ] || return 0
  lock
  hold_remove "$id"
  reconcile
  unlock
}

# hooks / plugin から stdin の JSON を受け取る入口。
# CLI 本体の動作を妨げないよう、何があっても終了コード 0 を返す。
cmd_hook() {
  local action="${1:-}" payload id
  payload="$(cat 2>/dev/null)"
  id="$(printf '%s' "$payload" | /usr/bin/jq -r '.session_id // .sessionID // empty' 2>/dev/null)"
  [ -n "$id" ] || id="fallback-$(find_owner_pid "$PPID")"

  case "$action" in
    acquire) cmd_acquire "$id" --label claude ;;
    release) cmd_release "$id" ;;
    *)       log "hook: 不明なアクション $action" ;;
  esac
  return 0
}

cmd_doctor() {
  local ok=0
  printf '前提条件を確認します\n\n'

  if [ -x "$HELPER" ]; then
    printf '  [OK]   helper が存在します: %s\n' "$HELPER"
  else
    printf '  [NG]   helper がありません: %s\n' "$HELPER"; ok=1
  fi

  if sudo -n -l 2>/dev/null | grep -qF "$HELPER"; then
    printf '  [OK]   sudo をパスワードなしで実行できます\n'
  else
    printf '  [NG]   sudoers に NOPASSWD 設定がありません\n'; ok=1
  fi

  if [ -x /usr/bin/jq ]; then
    printf '  [OK]   jq が利用できます\n'
  else
    printf '  [NG]   jq がありません (hooks の JSON 解析に必要)\n'; ok=1
  fi

  if mkdir -p "$STATE_DIR" 2>/dev/null && [ -w "$STATE_DIR" ]; then
    printf '  [OK]   状態ディレクトリに書き込めます: %s\n' "$STATE_DIR"
  else
    printf '  [NG]   状態ディレクトリに書き込めません: %s\n' "$STATE_DIR"; ok=1
  fi

  # 前提条件ではないので ok は変えない。気付けるように警告だけ出す
  local ov_day
  ov_day="$(override_count_since $(( $(now) - 86400 )))"
  if [ "$ov_day" -gt 0 ]; then
    printf '  [警告] 直近 24 時間に %s 回、外部から SleepDisabled が書き換えられました (最終 %s)\n' \
      "$ov_day" "$(date -r "$(tail -n 1 "$OVERRIDES" | cut -d' ' -f1)" '+%m/%d %H:%M:%S')"
    printf '         リモートデスクトップやスリープ管理のアプリが pmset で設定を書き換えている可能性があります。\n'
    printf '         書き換えられると、蓋を閉じたまま寝てしまうことがあります。\n'
    printf '         そのアプリのスリープ設定を見直すか、蓋閉じ運用中は終了してください。\n'
  else
    printf '  [OK]   外部による SleepDisabled の書き換えはありません (直近 24 時間)\n'
  fi

  printf '\n現在のスリープ設定 (承認待ちで放置したときの猶予):\n'
  printf '  バッテリー : ディスプレイオフ %s 分 + スリープ %s 分\n' \
    "$("$PMSET" -g custom 2>/dev/null | awk '/^Battery/,/^AC/ { if ($1 == "displaysleep") print $2 }' | head -1)" \
    "$("$PMSET" -g custom 2>/dev/null | awk '/^Battery/,/^AC/ { if ($1 == "sleep") print $2 }' | head -1)"

  [ "$ok" -eq 0 ] && printf '\nすべて問題ありません\n' || printf '\n上記の [NG] を解消してください\n'
  return "$ok"
}

usage() {
  cat <<'USAGE'
wakelock - Mac の蓋を閉じたまま CLI エージェントを走らせる

使い方:
  wakelock auto on
      自動モードを有効にする。以後 claude / opencode を普通に起動するだけで、
      作業中は蓋を閉じても動き、承認待ちで放置されれば通常のスリープ設定に戻る。
      コマンドを打ち分ける必要はなくなる。
  wakelock auto off      自動モードを解除する
  wakelock auto status   自動モードの状態を表示する

  wakelock run [--hooked|--always] [--for <期間>] <コマンド> [引数...]
      コマンドの実行中だけ有効化する。終了時に自動で解除される。
      claude / opencode は --hooked が既定で、作業中だけスリープを無効化し、
      承認待ちで放置されたときは通常のスリープ設定に戻る。
      それ以外のコマンドは --always が既定で、実行中はずっと無効化する。

  wakelock on [--hooked] [<期間>]
      CLI と無関係に手動で有効化する。既定は 2h で自動失効する。
      期間に 0 を渡すと無期限になる（自動では解除されない）。

  wakelock off       すべて解除する
  wakelock status    現在の状態を表示する
  wakelock doctor    前提条件を確認する

期間の書式: 90m / 2h / 45s / 30 (数値のみは分) / 0 (無期限)

例:
  wakelock auto on                         一度だけ実行すればあとは自動
  wakelock run --for 3h -- npm run build   hooks のないコマンドを包む
  wakelock on 90m                          CLI と無関係に手動で有効化
USAGE
}

# ---------------------------------------------------------------- ディスパッチ

main() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    run)     cmd_run "$@" ;;
    on)      cmd_on "$@" ;;
    auto)    cmd_auto "$@" ;;
    off)     cmd_off ;;
    status)  cmd_status "$@" ;;
    doctor)  cmd_doctor ;;
    acquire) cmd_acquire "$@" ;;
    release) cmd_release "$@" ;;
    hook)    cmd_hook "$@" ;;
    guard)   cmd_guard ;;
    ''|-h|--help|help) usage ;;
    *)       printf 'wakelock: 不明なサブコマンド: %s\n\n' "$sub" >&2; usage >&2; exit 64 ;;
  esac
}

main "$@"
